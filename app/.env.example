# ============================================================
# Boiler Control System — zmienne środowiskowe
# Skopiuj jako .env i uzupełnij wartościami
# NIGDY nie commituj .env do repozytorium!
# ============================================================

# Bojler Electrolux EWH
BOILER_IP=192.168.1.50
BOILER_PORT=41122
# Token i klucz publiczny bojlera — uzyskasz je przy parowaniu urządzenia
BOILER_TOKEN=
BOILER_PUB=

# Hypontech Cloud API (inwerter PV)
HYPON_USER=twoj@email.com
HYPON_PASS=TwojeHaslo
HYPON_STATION=<id-stacji-z-hypon-cloud>

# Flask session
SECRET_KEY=wygeneruj-losowy-klucz-min-32-znaki

# Domyślny użytkownik (tworzony jeśli DB jest pusta)
DEFAULT_USER=admin
DEFAULT_PASS=zmien_to_haslo

# Ścieżki (domyślnie dla Docker — nie zmieniaj)
DB_PATH=/var/lib/boiler/boiler.db
CFG_FILE=/var/lib/boiler/config.json
LOG_DIR=/var/log/boiler
